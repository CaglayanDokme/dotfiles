#!/bin/sh
# CPU and RAM usage for the tmux status line: prints e.g. "CPU 7% RAM 11GB/15GB", or
# "CPU 45% (2/8 over 80%) RAM 11GB/15GB" while some cores are above 80%.
# Called from status-right every status-interval. CPU is the busy share since the previous call
# (previous /proc/stat totals, overall and per core, kept in a per-user file in $XDG_RUNTIME_DIR),
# so the first call after boot shows the average since boot. RAM used = MemTotal - MemAvailable (cache not counted),
# in GiB rounded to whole numbers; MemTotal is what the kernel can use, a bit below installed RAM.
# Above 80% (of CPU, or of RAM used) a value turns orange, above 90% red.

state="${XDG_RUNTIME_DIR:-/tmp}/tmux-sysstat.$(id -u)"

# "<overall CPU percent> <cores above 80%> <core count>". The state file holds one
# "<name> <total> <idle>" line per cpu line of /proc/stat; a name missing from it counts from zero.
: >> "$state"
read -r cpu hot ncores <<EOF
$(awk -v state="$state" '
    FILENAME == state { pt[$1] = $2; pi[$1] = $3; next }
    /^cpu/ {
        t = $2 + $3 + $4 + $5 + $6 + $7 + $8 + $9; i = $5 + $6
        printf "%s %.0f %.0f\n", $1, t, i > state ".new"
        dt = t - pt[$1]; di = i - pi[$1]
        pct = dt > 0 ? int((100 * (dt - di) + dt / 2) / dt) : 0
        if ($1 == "cpu") all = pct
        else { n++; if (pct > 80) h++ }
    }
    END { printf "%d %d %d", all, h, n }' "$state" /proc/stat 2>/dev/null)
EOF
mv -f "$state.new" "$state"

# "<percent used> <used GiB> <total GiB>"
read -r ram_pct ram_used ram_total <<EOF
$(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2}
       END {g = 1048576; printf "%d %d %d", (100 * (t - a) + t / 2) / t, (t - a) / g + 0.5, t / g + 0.5}' /proc/meminfo)
EOF

# color <percent> <text>
color() {
    if   [ "$1" -gt 90 ]; then printf '#[fg=colour196,bold]%s#[default]' "$2"
    elif [ "$1" -gt 80 ]; then printf '#[fg=colour214]%s#[default]' "$2"
    else printf '%s' "$2"
    fi
}

cores=""
[ "$hot" -gt 0 ] && cores=" (${hot}/${ncores} over 80%)"

printf 'CPU %s%s RAM %s' "$(color "$cpu" "${cpu}%")" "$cores" "$(color "$ram_pct" "${ram_used}GB/${ram_total}GB")"
