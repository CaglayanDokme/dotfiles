# Generic ssh client defaults (public dotfiles). Machine/company hosts live in
# ~/.ssh/config.d/*.conf, which is NOT versioned. ssh uses the FIRST value it reads, so the
# host-specific Include comes first and Host * defaults last. Relative Include paths
# resolve under ~/.ssh. ssh refuses this file if it is group/world-writable: keep it 0600.
Include config.d/*.conf

Host *
    AddKeysToAgent yes
    GSSAPIAuthentication no
    ServerAliveInterval 30
    ServerAliveCountMax 4
